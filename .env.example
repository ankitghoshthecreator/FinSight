# FinSight RAG — Environment Configuration
# Copy this to .env and fill in your values.
# All fields have safe defaults; only override what you need.

# ── API ────────────────────────────────────────────────────────────────────
APP_NAME="FinSight RAG API"
APP_VERSION="2.0.0"
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# ── Security ───────────────────────────────────────────────────────────────
# Leave blank to disable API key auth (dev only).
# In production set a strong random value: openssl rand -hex 32
API_KEY_SECRET=

# Restrict CORS in production: CORS_ORIGINS=["https://your-domain.com"]
CORS_ORIGINS=["*"]

# Requests per IP per minute (0 = disabled)
RATE_LIMIT_PER_MINUTE=60

# ── Embedding ──────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Generation ─────────────────────────────────────────────────────────────
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Set to false in production to use real LLM instead of heuristic extractor
FINSIGHT_TEST_MODE=true

# ── Chunking ───────────────────────────────────────────────────────────────
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# ── Retrieval ──────────────────────────────────────────────────────────────
DEFAULT_TOP_K=5
BM25_WEIGHT=0.5
DENSE_WEIGHT=0.5
COLBERT_FUSION_WEIGHT=0.65

# ── Vector Store ───────────────────────────────────────────────────────────
# 'faiss' = local in-memory with optional disk persistence
# 'qdrant' = Qdrant server mode (requires QDRANT_URL)
VECTOR_STORE_BACKEND=faiss
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=finsight_chunks
FAISS_PERSIST_DIR=./data/faiss_index

# ── Ingestion ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
REDACT_PII_DEFAULT=true

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
